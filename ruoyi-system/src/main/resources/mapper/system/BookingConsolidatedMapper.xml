<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.BookingConsolidatedMapper">
    
    <resultMap type="BookingConsolidated" id="BookingConsolidatedResult">
        <id property="id" column="id" />
        <result property="bookingNo"    column="booking_no"    />
        <result property="shipper"    column="shipper"    />
        <result property="consignee"    column="consignee"    />
        <result property="notifyParty"    column="notify_party"    />
        <result property="vesselVoyage"    column="vessel_voyage"    />
        <result property="portOfLoading"    column="port_of_loading"    />
        <result property="portOfDischarge"    column="port_of_discharge"    />
        <result property="placeOfDelivery"    column="place_of_delivery"    />
        <!-- 注意：bill_of_lading表用的是goods_description，需要映射到cargoDescription -->
        <result property="cargoDescription"    column="goods_description"    />
        <!-- package_quantity + package_unit 需要合并为cargoQuantity -->
        <result property="cargoQuantity"    column="package_quantity_text"    />
        <result property="cargoGrossWeight"    column="gross_weight_kgs"    />
        <result property="cargoMeasurement"    column="measurement_cbm"    />
        <!-- container_seal_info需要拆分，但先整体映射 -->
        <result property="containerNo"    column="container_no"    />
        <result property="sealNo"    column="seal_no"    />
        <result property="vgm"    column="vgm"    />
        <result property="vgmUnit"    column="vgm_unit"    />
        <result property="filePath"    column="file_path"    />
        <result property="createdAt"    column="created_at"    />
    </resultMap>

    <sql id="selectBookingConsolidatedVo">
        select 
            id,
            booking_no, 
            shipper, 
            consignee, 
            notify_party, 
            vessel_voyage, 
            port_of_loading, 
            port_of_discharge, 
            place_of_delivery, 
            goods_description,
            CONCAT(IFNULL(package_quantity, ''), ' ', IFNULL(package_unit, '')) as package_quantity_text,
            gross_weight_kgs,
            measurement_cbm,
            SUBSTRING_INDEX(container_seal_info, '/', 1) as container_no,
            SUBSTRING_INDEX(container_seal_info, '/', -1) as seal_no,
            NULL as vgm,
            NULL as vgm_unit,
            file_path, 
            created_at
        from bill_of_lading_v3
    </sql>





    <select id="selectBookingConsolidatedList" parameterType="BookingConsolidated" resultMap="BookingConsolidatedResult">
        <include refid="selectBookingConsolidatedVo"/>
        <where>  
            <if test="shipper != null  and shipper != ''"> and shipper like concat('%', #{shipper}, '%')</if>
            <if test="consignee != null  and consignee != ''"> and consignee like concat('%', #{consignee}, '%')</if>
            <if test="notifyParty != null  and notifyParty != ''"> and notify_party like concat('%', #{notifyParty}, '%')</if>
            <if test="vesselVoyage != null  and vesselVoyage != ''"> and vessel_voyage like concat('%', #{vesselVoyage}, '%')</if>
            <if test="portOfLoading != null  and portOfLoading != ''"> and port_of_loading like concat('%', #{portOfLoading}, '%')</if>
            <if test="portOfDischarge != null  and portOfDischarge != ''"> and port_of_discharge like concat('%', #{portOfDischarge}, '%')</if>
            <if test="placeOfDelivery != null  and placeOfDelivery != ''"> and place_of_delivery like concat('%', #{placeOfDelivery}, '%')</if>
            <if test="cargoDescription != null  and cargoDescription != ''"> and goods_description like concat('%', #{cargoDescription}, '%')</if>
            <if test="cargoQuantity != null  and cargoQuantity != ''"> and package_quantity = #{cargoQuantity}</if>
            <if test="cargoGrossWeight != null "> and gross_weight_kgs = #{cargoGrossWeight}</if>
            <if test="cargoMeasurement != null "> and measurement_cbm = #{cargoMeasurement}</if>
            <if test="containerNo != null  and containerNo != ''"> and container_seal_info like concat('%', #{containerNo}, '%')</if>
            <if test="sealNo != null  and sealNo != ''"> and container_seal_info like concat('%', #{sealNo}, '%')</if>
            <if test="filePath != null  and filePath != ''"> and file_path like concat('%', #{filePath}, '%')</if>
        </where>
        order by created_at desc
    </select>
    
    <select id="selectBookingConsolidatedByBookingNo" parameterType="String" resultMap="BookingConsolidatedResult">
        <include refid="selectBookingConsolidatedVo"/>
        where booking_no = #{bookingNo}
    </select>

    <insert id="insertBookingConsolidated" parameterType="BookingConsolidated">
        insert into booking_consolidated
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="bookingNo != null">booking_no,</if>
            <if test="shipper != null">shipper,</if>
            <if test="consignee != null">consignee,</if>
            <if test="notifyParty != null">notify_party,</if>
            <if test="vesselVoyage != null">vessel_voyage,</if>
            <if test="portOfLoading != null">port_of_loading,</if>
            <if test="portOfDischarge != null">port_of_discharge,</if>
            <if test="placeOfDelivery != null">place_of_delivery,</if>
            <if test="cargoDescription != null">cargo_description,</if>
            <if test="cargoQuantity != null">cargo_quantity,</if>
            <if test="cargoGrossWeight != null">cargo_gross_weight,</if>
            <if test="cargoMeasurement != null">cargo_measurement,</if>
            <if test="containerNo != null">container_no,</if>
            <if test="sealNo != null">seal_no,</if>
            <if test="vgm != null">vgm,</if>
            <if test="vgmUnit != null">vgm_unit,</if>
            <if test="filePath != null and filePath != ''">file_path,</if>
            <if test="createdAt != null">created_at,</if>
            <if test="updatedAt != null">updated_at,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="bookingNo != null">#{bookingNo},</if>
            <if test="shipper != null">#{shipper},</if>
            <if test="consignee != null">#{consignee},</if>
            <if test="notifyParty != null">#{notifyParty},</if>
            <if test="vesselVoyage != null">#{vesselVoyage},</if>
            <if test="portOfLoading != null">#{portOfLoading},</if>
            <if test="portOfDischarge != null">#{portOfDischarge},</if>
            <if test="placeOfDelivery != null">#{placeOfDelivery},</if>
            <if test="cargoDescription != null">#{cargoDescription},</if>
            <if test="cargoQuantity != null">#{cargoQuantity},</if>
            <if test="cargoGrossWeight != null">#{cargoGrossWeight},</if>
            <if test="cargoMeasurement != null">#{cargoMeasurement},</if>
            <if test="containerNo != null">#{containerNo},</if>
            <if test="sealNo != null">#{sealNo},</if>
            <if test="vgm != null">#{vgm},</if>
            <if test="vgmUnit != null">#{vgmUnit},</if>
            <if test="filePath != null and filePath != ''">#{filePath},</if>
            <if test="createdAt != null">#{createdAt},</if>
            <if test="updatedAt != null">#{updatedAt},</if>
         </trim>
    </insert>

    <update id="updateBookingConsolidated" parameterType="BookingConsolidated">
        update bill_of_lading_v3
        <trim prefix="SET" suffixOverrides=",">
            <if test="bookingNo != null">booking_no = #{bookingNo},</if>
            <if test="shipper != null">shipper = #{shipper},</if>
            <if test="consignee != null">consignee = #{consignee},</if>
            <if test="notifyParty != null">notify_party = #{notifyParty},</if>
            <if test="vesselVoyage != null">vessel_voyage = #{vesselVoyage},</if>
            <if test="portOfLoading != null">port_of_loading = #{portOfLoading},</if>
            <if test="portOfDischarge != null">port_of_discharge = #{portOfDischarge},</if>
            <if test="placeOfDelivery != null">place_of_delivery = #{placeOfDelivery},</if>
            <if test="cargoDescription != null">goods_description = #{cargoDescription},</if>
            <if test="cargoGrossWeight != null">gross_weight_kgs = #{cargoGrossWeight},</if>
            <if test="cargoMeasurement != null">measurement_cbm = #{cargoMeasurement},</if>
            <if test="containerNo != null and sealNo != null">container_seal_info = CONCAT(#{containerNo}, '/', #{sealNo}),</if>
            <if test="filePath != null and filePath != ''">file_path = #{filePath},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteBookingConsolidatedByBookingNo" parameterType="Long">
        delete from bill_of_lading_v3 where id = #{id}
    </delete>

    <delete id="deleteBookingConsolidatedByBookingNos" parameterType="Long">
        delete from bill_of_lading_v3 where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>