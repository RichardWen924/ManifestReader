        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    <select id="checkDocNoUnique" resultType="int">
        select count(1) from bill_of_lading_v5
        where doc_no = #{docNo}
