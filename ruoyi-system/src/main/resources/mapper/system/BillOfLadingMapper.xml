    <sql id="selectBillOfLadingVo">
        select id, bl_no, booking_no, doc_no, serial_no, shipper, consignee, notify_party, carrier_agent, 
               delivery_agent, pre_carriage_by, vessel_voyage, place_of_receipt, port_of_loading, port_of_discharge, 
               place_of_delivery, container_seal_info, package_quantity, package_unit, goods_description, 
               gross_weight_kgs, measurement_cbm, freight_term, service_type, service_mode, revenue_tons, freight_rate, 
               prepaid_amount, collect_amount, payable_at, laden_on_board, marks, original_bl_count, issue_place, 
               file_path, created_at, container_no, seal_no, container_weight, vgm_weight
        from bill_of_lading_v5
    </sql>

    <select id="selectBillOfLadingById" parameterType="Long" resultMap="BillOfLadingResult">
        <include refid="selectBillOfLadingVo"/>
        where id = #{id}
    </select>

    <select id="selectBillOfLadingByBlNo" parameterType="String" resultMap="BillOfLadingResult">
        <include refid="selectBillOfLadingVo"/>
        where bl_no = #{blNo}
    </select>

    <select id="selectBillOfLadingList" parameterType="BillOfLading" resultMap="BillOfLadingResult">
        <include refid="selectBillOfLadingVo"/>
        <where>  
            <if test="blNo != null  and blNo != ''"> and bl_no = #{blNo}</if>
            <if test="bookingNo != null  and bookingNo != ''"> and booking_no = #{bookingNo}</if>
            <if test="shipper != null  and shipper != ''"> and shipper like concat('%', #{shipper}, '%')</if>
            <if test="consignee != null  and consignee != ''"> and consignee like concat('%', #{consignee}, '%')</if>
            <if test="vesselVoyage != null  and vesselVoyage != ''"> and vessel_voyage like concat('%', #{vesselVoyage}, '%')</if>
            <if test="portOfLoading != null  and portOfLoading != ''"> and port_of_loading = #{portOfLoading}</if>
            <if test="portOfDischarge != null  and portOfDischarge != ''"> and port_of_discharge = #{portOfDischarge}</if>
        </where>
        order by created_at desc
    </select>
    
