<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.BillOfLadingMapper">
    
    <resultMap type="BillOfLading" id="BillOfLadingResult">
        <result property="id"    column="id"    />
        <result property="blNo"    column="bl_no"    />
        <result property="bookingNo"    column="booking_no"    />
        <result property="docNo"    column="doc_no"    />
        <result property="serialNo"    column="serial_no"    />
        <result property="vesselVoyage"    column="vessel_voyage"    />
        <result property="preCarriageBy"    column="pre_carriage_by"    />
        <result property="placeOfReceipt"    column="place_of_receipt"    />
        <result property="portOfLoading"    column="port_of_loading"    />
        <result property="portOfDischarge"    column="port_of_discharge"    />
        <result property="placeOfDelivery"    column="place_of_delivery"    />
        <result property="filePath"    column="file_path"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="created_at"    />
        
        <!-- 嵌套组件映射 -->
        <association property="parties" javaType="BlParties">
            <result property="shipper" column="shipper"/>
            <result property="consignee" column="consignee"/>
            <result property="notifyParty" column="notify_party"/>
            <result property="carrierAgent" column="carrier_agent"/>
            <result property="deliveryAgent" column="delivery_agent"/>
        </association>
        
        <association property="cargo" javaType="BlCargo">
            <result property="containerNo" column="container_no"/>
            <result property="sealNo" column="seal_no"/>
            <result property="containerWeight" column="container_weight"/>
            <result property="vgmWeight" column="vgm_weight"/>
            <result property="packageQuantity" column="package_quantity"/>
            <result property="packageUnit" column="package_unit"/>
            <result property="goodsDescription" column="goods_description"/>
            <result property="grossWeightKgs" column="gross_weight_kgs"/>
            <result property="measurementCbm" column="measurement_cbm"/>
            <result property="containerSealInfo" column="container_seal_info"/>
            <result property="marks" column="marks"/>
        </association>
        
        <association property="freight" javaType="BlFreight">
            <result property="serviceType" column="service_type"/>
            <result property="serviceMode" column="service_mode"/>
            <result property="revenueTons" column="revenue_tons"/>
            <result property="freightTerm" column="freight_term"/>
            <result property="freightRate" column="freight_rate"/>
            <result property="prepaidAmount" column="prepaid_amount"/>
            <result property="collectAmount" column="collect_amount"/>
            <result property="payableAt" column="payable_at"/>
            <result property="originalBlCount" column="original_bl_count"/>
            <result property="issuePlace" column="issue_place"/>
            <result property="ladenOnBoard" column="laden_on_board"/>
        </association>
    </resultMap>

    <sql id="selectBillOfLadingVo">
        select m.id, m.bl_no, m.booking_no, m.doc_no, m.serial_no, m.vessel_voyage, m.port_of_loading, 
               m.port_of_discharge, m.place_of_receipt, m.place_of_delivery, m.pre_carriage_by, m.file_path, 
               m.created_at, m.create_by,
               p.shipper, p.consignee, p.notify_party, p.carrier_agent, p.delivery_agent,
               c.container_no, c.seal_no, c.container_weight, c.vgm_weight, c.package_quantity, 
               c.package_unit, c.goods_description, c.gross_weight_kgs, c.measurement_cbm, 
               c.container_seal_info, c.marks,
               f.service_type, f.service_mode, f.revenue_tons, f.freight_term, f.freight_rate, 
               f.prepaid_amount, f.collect_amount, f.payable_at, f.original_bl_count, f.issue_place, f.laden_on_board
        from bl_main m
        left join bl_parties p on m.id = p.bl_id
        left join bl_cargo c on m.id = c.bl_id
        left join bl_freight f on m.id = f.bl_id
    </sql>

    <select id="selectBillOfLadingById" parameterType="Long" resultMap="BillOfLadingResult">
        <include refid="selectBillOfLadingVo"/>
        where m.id = #{id}
    </select>

    <select id="selectBillOfLadingByBlNo" parameterType="String" resultMap="BillOfLadingResult">
        <include refid="selectBillOfLadingVo"/>
        where m.bl_no = #{blNo}
    </select>

    <select id="selectBillOfLadingList" parameterType="BillOfLading" resultMap="BillOfLadingResult">
        <include refid="selectBillOfLadingVo"/>
        <where>  
            <if test="blNo != null  and blNo != ''"> and m.bl_no = #{blNo}</if>
            <if test="bookingNo != null  and bookingNo != ''"> and m.booking_no = #{bookingNo}</if>
            <if test="shipper != null  and shipper != ''"> and p.shipper like concat('%', #{shipper}, '%')</if>
            <if test="consignee != null  and consignee != ''"> and p.consignee like concat('%', #{consignee}, '%')</if>
            <if test="vesselVoyage != null  and vesselVoyage != ''"> and m.vessel_voyage like concat('%', #{vesselVoyage}, '%')</if>
            <if test="portOfLoading != null  and portOfLoading != ''"> and m.port_of_loading = #{portOfLoading}</if>
            <if test="portOfDischarge != null  and portOfDischarge != ''"> and m.port_of_discharge = #{portOfDischarge}</if>
            <if test="createBy != null and createBy != ''"> and m.create_by = #{createBy}</if>
        </where>
        order by m.created_at desc
    </select>

    <select id="checkDocNoUnique" resultType="int">
        select count(1) from bl_main
        where doc_no = #{docNo}
        <if test="id != null"> and id != #{id}</if>
    </select>

    <update id="updateDocNoPrefix">
        update bl_main 
        set doc_no = concat(#{newPrefix}, substr(doc_no, 5))
        where create_by = #{createBy}
    </update>

</mapper>
